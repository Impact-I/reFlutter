#!/bin/bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
RELEASE_DIR="$REPO_ROOT/release"

# prefer a writable pip bin over stale root-owned framework scripts
export PATH="/opt/homebrew/bin:$PATH"

# ---- flags ----
BUILD_V2=true
BUILD_V3=true
DO_BUILD=true
DO_UPLOAD=true
VERBOSE=false
SHOREBIRD=false
FRESH_SYNC=false
HASH_OVERRIDE=""
BASE_COMMIT=""

usage() {
  cat <<'EOF'
Usage: local-release [flags]

Builds the reFlutter-patched engine (v2 traffic / v3 dump, iOS + Android
arm64/arm/x64) for a snapshot hash and uploads the release assets.

Flags:
  --v2-only        Build only engine v2 (reflutter without -p)
  --v3-only        Build only engine v3 (reflutter with -p)
  --build-only     Build only; skip gh release upload step
  --upload-only    Upload existing release/ artifacts; skip build
  --shorebird      Build a Shorebird-flavored engine: the hash row comes from
                   enginehash_sb.csv and assets are tagged with the sb-
                   prefix. The build tree stays VANILLA (shorebirdtech's
                   dart-sdk fork is private) - requires --base so the tree
                   matches the Flutter version the Shorebird engine targets.
  --hash <hash>    Snapshot hash to build (default: SNAPSHOT_HASH file)
  --base <commit>  Vanilla engine commit to build a --shorebird flavor on
  --fresh          Full gclient re-sync even when the engine changed
                   (default is an incremental sync, which also makes
                   historical backfills fast)
  --verbose        Trace commands
  --help           Show this message

Batch/backfill: scripts/backfill '<hash> <hash> ...' [--shorebird --base <c>]
EOF
  exit 0
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --v2-only) BUILD_V3=false ;;
    --v3-only) BUILD_V2=false ;;
    --build-only) DO_UPLOAD=false ;;
    --upload-only) DO_BUILD=false ;;
    --shorebird) SHOREBIRD=true ;;
    --fresh) FRESH_SYNC=true ;;
    --hash) HASH_OVERRIDE="$2"; shift ;;
    --base) BASE_COMMIT="$2"; shift ;;
    --verbose) VERBOSE=true ;;
    --help) usage ;;
    *) echo "Unknown flag: $1" >&2; usage >&2; exit 1 ;;
  esac
  shift
done

SNAPSHOT_HASH="${HASH_OVERRIDE:-$(cat "$REPO_ROOT/SNAPSHOT_HASH")}"
TAG_SUFFIX=""
if $SHOREBIRD; then
  TAG_SUFFIX="sb-"
fi

if $VERBOSE; then set -x; fi

say()  { echo "==> $(date '+%H:%M:%S')  $*"; }
warn() { echo "!!! $*" >&2; }
die()  { warn "$*"; exit 1; }

# ---- guards ----
command -v brew  >/dev/null 2>&1 || die "brew not found"
command -v ninja >/dev/null 2>&1 || brew install ninja

if ! gh auth status >/dev/null 2>&1 && [[ -z "${GITHUB_TOKEN:-}" ]]; then
  die "gh not authenticated — run 'gh auth login' or set GITHUB_TOKEN"
fi

# ---- install deps ----
say "Installing build dependencies (brew) …"
brew install libusbmuxd ideviceinstaller ios-deploy python@3.13 2>/dev/null || true

say "Installing reflutter python package …"
cd "$REPO_ROOT"
python3 -m pip install wheel --break-system-packages 2>/dev/null || true
python3 -m pip install . --break-system-packages 2>/dev/null || true

# ---- compiler wrapper: macOS SDK 26+ deprecates readdir_r; -Werror makes it fatal ----
# The engine invokes clang via relative paths, so we must replace the bundled binaries.
inject_clang_wrapper() {
  local clang_dir="$GCLIENT_DIR/engine/src/flutter/buildtools/mac-arm64/clang/bin"
  for name in clang clang++; do
    local real="$clang_dir/$name"
    if [[ -x "$real" ]] && [[ ! -f "$real.real" ]]; then
      mv "$real" "$real.real"
      cat > "$real" << 'CLANG_WRAPPER'
#!/bin/bash
exec "${0}.real" "$@" -Wno-deprecated-declarations
CLANG_WRAPPER
      chmod +x "$real"
      say "  Wrapped $name for macOS SDK 26 compatibility"
    fi
  done
}

# ---- depot_tools ----
if [[ ! -d "$REPO_ROOT/depot_tools" ]]; then
  say "Cloning depot_tools …"
  git clone https://chromium.googlesource.com/chromium/tools/depot_tools.git "$REPO_ROOT/depot_tools"
fi
export PATH="$PATH:$REPO_ROOT/depot_tools"

# ---- gclient cache dir (survives between runs, avoids re-cloning deps) ----
GCLIENT_CACHE="$REPO_ROOT/.gclient_cache"
mkdir -p "$GCLIENT_CACHE"
export GIT_CACHE_PATH="$GCLIENT_CACHE"

# ---- prepare flutter engine repo ----
ENGINE_DIR="$REPO_ROOT/engine"
if [[ ! -d "$ENGINE_DIR" ]]; then
  say "Cloning flutter repo (engine source) …"
  git clone https://github.com/flutter/flutter.git "$ENGINE_DIR"
fi

# ---- retry helper ----
retry_gclient() {
  local max_retries=5
  local delay=60
  for i in $(seq 1 $max_retries); do
    if gclient sync --no-history --delete_unversioned_trees 2>&1; then
      return 0
    fi
    if [[ $i -eq $max_retries ]]; then
      die "gclient sync failed after $max_retries attempts"
    fi
    warn "gclient sync failed (attempt $i/$max_retries) — rate limited. Waiting ${delay}s …"
    sleep "$delay"
    delay=$((delay * 2))
  done
}

# ---- ninja build helper ----
# Usage: ninja_build "iOS release" "src/out/ios_release" "Flutter.framework/Flutter" "$out/Flutter" --ios
# First 4 args: label, output-dir, output-file, dest.  Remaining args go to gn (e.g. --ios, --android).
ninja_build() {
  local target="$1"
  local out_dir="$2"
  local out_file="$3"
  local dst="$4"
  shift 4  # now $@ contains only the platform flags for gn

  say "ninja: $target …"
  "$ENG"/src/flutter/tools/gn --no-goma "$@" --runtime-mode=release
  # build ONLY the artifact we ship - the default (all) target also builds
  # the framework's unit tests, whose prebuilts XCTest headers use newer
  # availability macros (visionos) unknown to older engines' pinned clang
  ninja -C "$ENG/$out_dir" "$out_file"
  cp "$ENG/$out_dir/$out_file" "$dst" 2>/dev/null || true
  say "  -> $dst"
}

# ---- main build ----
cd "$REPO_ROOT"

if $DO_BUILD; then

  # === PHASE 1: Prepare the engine source (once) ===
  say "Preparing Flutter engine source …"
  cd "$ENGINE_DIR"
  if $SHOREBIRD; then
    # The sb CSV row only supplies the snapshot-hash override baked into
    # make_version; the source tree itself stays vanilla at the matching
    # Flutter version (shorebirdtech's dart-sdk fork is private, but their
    # dart is a rebase onto upstream, so a vanilla-base engine with their
    # hash accepts their snapshots).
    ENGINE_COMMIT="$BASE_COMMIT"
    [[ -n "$ENGINE_COMMIT" ]] || die "--shorebird requires --base <vanilla engine commit> (the Flutter version the Shorebird targets)"
  else
    ENGINE_COMMIT="$(reflutter -b "$SNAPSHOT_HASH" | head -1)"
  fi
  say "Engine commit: $ENGINE_COMMIT"
  # pre-merge engines (<= 3.27, early 2025) predate the flutter/flutter +
  # flutter/engine monorepo merge: their commits live only in the archived
  # flutter/engine repo. Fetch from there and use the pre-merge gclient
  # layout below (engine repo as solution "src/flutter" under gclient root
  # $GCLIENT_DIR/engine - which still yields $ENG/src/flutter with dart and
  # boringssl beside it, exactly what every downstream path expects).
  PRE_MERGE=false
  if ! git fetch origin "$ENGINE_COMMIT" 2>/dev/null; then
    say "commit not in flutter/flutter - trying archived flutter/engine …"
    if ! git fetch https://github.com/flutter/engine.git "$ENGINE_COMMIT" 2>/dev/null; then
      die "engine commit $ENGINE_COMMIT not found in flutter/flutter OR flutter/engine - check the hash (a transient network failure also lands here)"
    fi
  fi
  # the COMMIT'S OWN TREE SHAPE decides the gclient layout, never which remote
  # served it: once a pre-merge object is cached locally, later "git fetch
  # origin <sha>" runs succeed against flutter/flutter even though the commit
  # lives only in the archived engine repo
  if git cat-file -e "$ENGINE_COMMIT:engine" 2>/dev/null; then
    PRE_MERGE=false
  else
    PRE_MERGE=true
  fi
  say "pre-merge engine layout: $PRE_MERGE"
  git reset --hard FETCH_HEAD
  git clean -fdx
  # after clean: reflutter -b resolves the hash from these CSVs, and a
  # locally-added row may not be on GitHub yet (fresh sb hash, unpushed
  # vanilla row) - copy all three so resolution is local-first
  for csv in enginehash.csv enginehash_sb.csv enginehash_profile.csv; do
    [[ -f "$REPO_ROOT/$csv" ]] && /bin/cp "$REPO_ROOT/$csv" .
  done

  # Apply base patches only (no -p): DEPS fixes, SSL bypass, make_version hash.
  # The -p flag (dump code, offset fixes) is applied per-variant after gclient sync.
  reflutter -b "$SNAPSHOT_HASH"
  echo 'reflutter' > REFLUTTER
  git add . && git commit -am "reflutter engine" || true
  git checkout -B main 2>/dev/null || true

  # === PHASE 2: gclient sync (once, shared by both variants) ===
  GCLIENT_DIR="$REPO_ROOT/gclient_synced"
  ENG="$GCLIENT_DIR/engine"
  if $PRE_MERGE; then
    GCLIENT_ROOT="$GCLIENT_DIR/engine"
    SOLUTION_NAME="src/flutter"
  else
    GCLIENT_ROOT="$GCLIENT_DIR"
    SOLUTION_NAME="."
  fi
  # cache key includes the layout: switching between pre-merge and monorepo
  # trees requires a fresh sync (different solution shapes overlap in paths),
  # but a commit change WITHIN a layout stays incremental
  LAYOUT="post"; $PRE_MERGE && LAYOUT="pre"
  CACHE_KEY="$ENGINE_COMMIT:$LAYOUT"
  if [[ -d "$GCLIENT_DIR" ]] && [[ -f "$GCLIENT_DIR/.gclient_hash" ]] && \
     [[ "$(cat "$GCLIENT_DIR/.gclient_hash")" == "$CACHE_KEY" ]]; then
    say "Reusing cached gclient sync for $ENGINE_COMMIT …"
  else
    OLD_KEY="$(cat "$GCLIENT_DIR/.gclient_hash" 2>/dev/null || true)"
    NEED_WIPE=false
    [[ -d "$GCLIENT_DIR" ]] || NEED_WIPE=true
    $FRESH_SYNC && NEED_WIPE=true
    # layout switch (or an unkeyed leftover tree) cannot be moved in place
    if [[ -n "$OLD_KEY" && "${OLD_KEY##*:}" != "$LAYOUT" ]] || [[ -z "$OLD_KEY" && -d "$GCLIENT_DIR" ]]; then
      NEED_WIPE=true
    fi
    if $NEED_WIPE; then
      say "Running gclient sync (this clones 90+ repos, 30+ GB) …"
      rm -rf "$GCLIENT_DIR"
      mkdir -p "$GCLIENT_ROOT"
    else
      # engine changed within the same layout - move the existing tree to
      # the new revision instead of re-cloning; keeps backfills cheap
      say "Running incremental gclient sync for $ENGINE_COMMIT …"
    fi
    cd "$GCLIENT_ROOT"
    echo 'solutions = [{"managed": False,"name": "'"$SOLUTION_NAME"'","url": "'"$ENGINE_DIR"'","custom_deps": {},"deps_file": "DEPS","safesync_url": "",},]' > .gclient
    # the previous build's patches sit in the nested gclient-managed repos
    # and must be reverted before gclient can move them to the new revision
    for nested in "$GCLIENT_DIR/engine/src/flutter/third_party/dart" "$GCLIENT_DIR/engine/src/flutter/third_party/boringssl/src"; do
      if [[ -d "$nested/.git" ]]; then
        git -C "$nested" checkout -- . 2>/dev/null || true
      fi
    done
    retry_gclient
    echo "$CACHE_KEY" > "$GCLIENT_DIR"/.gclient_hash
  fi

  inject_clang_wrapper

  # Xcode 27 SDK TBDs carry the arm64e.x1 arch token the pinned lld cannot
  # parse ("unknown architecture" -> every libc symbol undefined). Keep a
  # patched shadow copy and repoint the prebuilts/SDKs symlinks - gclient
  # sync resets them on every revision change.
  fix_macos_sdk_tbds() {
    local shadow="$REPO_ROOT/.xcode_sdk_shadow"
    local sdk_dir="$GCLIENT_DIR/engine/src/flutter/prebuilts/SDKs"
    for name in MacOSX27.0 iPhoneOS27.0; do
      local platform="${name%%[0-9]*}"
      local src="/Applications/Xcode.app/Contents/Developer/Platforms/${platform}.platform/Developer/SDKs/${name}.sdk"
      [[ -d "$src" ]] || continue
      if [[ ! -d "$shadow/${name}.sdk" ]]; then
        say "Creating patched shadow SDK ${name} …"
        /bin/cp -RH "$src" "$shadow/${name}.sdk"
        grep -rl "arm64e\.x1-" "$shadow/${name}.sdk" --include="*.tbd" 2>/dev/null | while read -r t; do
          sed -i '' 's/arm64e\.x1-/arm64e-/g' "$t"
        done
      fi
      # SDK 27's UIKit headers import <UIUtilities/UIDefines.h> etc. from
      # System/Library/SubFrameworks, which non-module builds (the engine
      # compiles UIKit-using code without clang modules) never search -
      # expose every SubFramework's Headers on the plain header path.
      # Idempotent: skips frameworks already exposed.
      local subfws="$shadow/${name}.sdk/System/Library/SubFrameworks"
      if [[ -d "$subfws" ]]; then
        local fw fwname
        for fw in "$subfws"/*.framework; do
          [[ -d "$fw/Headers" ]] || continue
          fwname="$(basename "$fw" .framework)"
          if [[ ! -e "$shadow/${name}.sdk/usr/include/$fwname" ]]; then
            mkdir -p "$shadow/${name}.sdk/usr/include/$fwname"
            /bin/cp -R "$fw/Headers/." "$shadow/${name}.sdk/usr/include/$fwname/"
            say "Exposed SubFramework $fwname headers in ${name}.sdk shadow"
          fi
        done
      fi
      if [[ -e "$sdk_dir/${name}.sdk" ]] && [[ "$(readlink "$sdk_dir/${name}.sdk" 2>/dev/null)" != "$shadow/${name}.sdk" ]]; then
        ln -sfn "$shadow/${name}.sdk" "$sdk_dir/${name}.sdk"
        say "Repointed ${name}.sdk to patched shadow"
      fi
    done
  }
  fix_macos_sdk_tbds

  # reflutter -b runs from the gclient ROOT: the monorepo checkout for
  # post-merge engines, $GCLIENT_DIR/engine for pre-merge (there the engine
  # repo sits at src/flutter and patch paths resolve via replace_file_text)
  if $PRE_MERGE; then
    REFLUTTER_CWD="$GCLIENT_DIR/engine"
  else
    REFLUTTER_CWD="$GCLIENT_DIR"
  fi

  # === PHASE 3: Build each variant ===
  # Fail loudly if any patch anchor drifted upstream: replace_file_text is a
  # silent no-op when its pattern no longer matches, and a partially-unpatched
  # engine would otherwise build and ship broken artifacts.
  verify_patches() {
    local flags="$1"
    local dart_root="$GCLIENT_DIR/engine/src/flutter/third_party/dart"
    local fail=0

    if ! grep -q "snapshot_hash = '$SNAPSHOT_HASH'" "$dart_root/tools/make_version.py"; then
      warn "PATCH MISS: make_version.py snapshot_hash override not applied"; fail=1
    fi
    if ! grep -q "out_alert) {return" "$dart_root/../boringssl/src/ssl/ssl_x509.cc"; then
      warn "PATCH MISS: boringssl ssl_x509.cc cert-chain bypass not applied"; fail=1
    fi
    if [[ "$flags" == *"-p"* ]]; then
      if ! grep -q "reFlutter dump file" "$dart_root/runtime/vm/app_snapshot.cc"; then
        warn "PATCH MISS: app_snapshot.cc dump instrumentation not applied"; fail=1
      fi
      if ! grep -q "reflutter_entry - reflutter_base" "$dart_root/runtime/vm/app_snapshot.cc"; then
        warn "PATCH MISS: app_snapshot.cc code-offset fix not applied"; fail=1
      fi
      if grep -q "FLAG_print_class_table)" "$dart_root/runtime/vm/dart.cc"; then
        warn "PATCH MISS: dart.cc class-table print not enabled"; fail=1
      fi
    fi
    if [[ $fail -ne 0 ]]; then
      die "Engine patches did not apply cleanly for this engine version — fix the anchors in reflutter/utils.py patch_source() before building"
    fi
    say "All engine patches verified for $flags variant"
  }

  build_variant() {
    local variant="$1"
    local reflutter_flags="$2"

    say ""
    say "========== BUILDING ENGINE $variant =========="
    local out="$RELEASE_DIR/$variant"
    mkdir -p "$out"

    # Reset tracked source files to clean gclient-synced state, then re-patch.
    # The nested gclient-managed repos must be reset too - a checkout at the
    # solution root leaves the previous variant's patches in dart/boringssl
    # and a later v2-only run would ship v3 instrumentation.
    cd "$REFLUTTER_CWD"
    git checkout -- . 2>/dev/null || true
    # pre-merge: the gclient root is not a git repo, so the checkout above
    # no-ops - reset the solution repo itself (post-merge this is a harmless
    # scoped subset of the same operation)
    git -C "$ENG/src/flutter" checkout -- . 2>/dev/null || true
    # reflutter -b runs HERE, so the CSVs must exist in this tree too -
    # Phase 1 only copies them into $ENGINE_DIR. Untracked files survive the
    # checkout above. Needed when a fresh sb hash row is only in the
    # repo-root CSV and GitHub's copy still lags it.
    for csv in enginehash.csv enginehash_sb.csv enginehash_profile.csv; do
      [[ -f "$REPO_ROOT/$csv" ]] && /bin/cp "$REPO_ROOT/$csv" "$REFLUTTER_CWD/$csv"
    done
    for nested in "$ENG/src/flutter/third_party/dart" "$ENG/src/flutter/third_party/boringssl/src"; do
      if [[ -d "$nested/.git" ]]; then
        git -C "$nested" checkout -- . 2>/dev/null || true
      fi
    done
    reflutter -b "$SNAPSHOT_HASH" $reflutter_flags
    verify_patches "$reflutter_flags"

    # iOS
    ninja_build "iOS release" "src/out/ios_release" "Flutter.framework/Flutter" "$out/Flutter" \
      --ios

    # Android arm64
    ninja_build "Android arm64" "src/out/android_release_arm64" "lib.stripped/libflutter.so" "$out/libflutter_arm64.so" \
      --android --android-cpu=arm64

    # Android arm
    ninja_build "Android arm" "src/out/android_release" "lib.stripped/libflutter.so" "$out/libflutter_arm.so" \
      --android --android-cpu=arm

    # Android x64
    ninja_build "Android x64" "src/out/android_release_x64" "lib.stripped/libflutter.so" "$out/libflutter_x64.so" \
      --android --android-cpu=x64

    say "Engine $variant build complete — artifacts in $out/"
  }

  # Note: v2 uses just the base patch, v3 adds -p (dump patch)
  # Both run from the same gclient-synced tree
  $BUILD_V2 && build_variant "v2" ""
  $BUILD_V3 && build_variant "v3" "-p"

  say ""
  say "All builds complete. Artifacts in $RELEASE_DIR/"
  ls -lh "$RELEASE_DIR"/v2/ 2>/dev/null || true
  ls -lh "$RELEASE_DIR"/v3/ 2>/dev/null || true
fi

# ---- upload ----
if $DO_UPLOAD; then
  # create the release if needed, otherwise refresh the assets in place so
  # re-runs (e.g. shipping a fixed engine under the same snapshot-hash tag)
  # do not fail on the existing tag
  release_upload() {
    local tag="$1"
    local title="$2"
    shift 2
    if gh release view "$tag" --repo Impact-I/reFlutter >/dev/null 2>&1; then
      say "Release $tag already exists - clobbering assets …"
      gh release upload "$tag" "$@" --clobber --repo Impact-I/reFlutter
    else
      gh release create "$tag" "$@" \
        --title "$title" \
        --notes "reFlutter engine build. Snapshot hash: $SNAPSHOT_HASH" \
        --repo Impact-I/reFlutter
    fi
  }

  upload_one_variant() {
    local variant="$1"
    local out="$RELEASE_DIR/$variant"

    say "Uploading ios-$variant-$TAG_SUFFIX$SNAPSHOT_HASH …"
    release_upload "ios-$variant-$TAG_SUFFIX$SNAPSHOT_HASH" "iOS $variant – $TAG_SUFFIX$SNAPSHOT_HASH" "$out/Flutter"

    say "Uploading android-$variant-$TAG_SUFFIX$SNAPSHOT_HASH …"
    release_upload "android-$variant-$TAG_SUFFIX$SNAPSHOT_HASH" "Android $variant – $TAG_SUFFIX$SNAPSHOT_HASH" \
      "$out"/libflutter_arm64.so \
      "$out"/libflutter_arm.so \
      "$out"/libflutter_x64.so
  }

  $BUILD_V2 && upload_one_variant "v2"
  $BUILD_V3 && upload_one_variant "v3"
  say "Uploads complete."
fi
