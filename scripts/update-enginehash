#!/bin/bash
# Engine hash-list refresh - run MANUALLY whenever you want the lists
# current (the org's GitHub Actions are locked by a billing issue, so this
# runs from the maintainer's machine; .github/workflows/update-enginehash.yml
# stays dormant for if/when Actions becomes available again).
#
# Run it any time - it is incremental and idempotent (existing rows resume
# from the CSVs, only new engine revisions are fetched), so a run costs
# seconds when nothing changed:
#   scripts/update-enginehash
# Want it scheduled anyway (only sensible on an always-on machine)?
#   scripts/install-enginehash-agent
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PY="$(command -v python3.10 || command -v python3)"
export PATH="/opt/homebrew/bin:$PATH"

"$PY" -m pip show requests >/dev/null 2>&1 || "$PY" -m pip install -q requests

cd "$ROOT"
"$PY" scripts/gen_enginehash.py --workers 6
"$PY" scripts/gen_enginehash.py --profile --workers 6
"$PY" scripts/gen_enginehash.py --shorebird --workers 6

# the CSVs the tool actually fetches live at the repo root
if git diff --quiet -- enginehash.csv enginehash_profile.csv enginehash_sb.csv; then
  echo "$(date '+%F %T') nothing to update"
  exit 0
fi
git add enginehash.csv enginehash_profile.csv enginehash_sb.csv
git commit -q -m "auto: refresh engine hash lists (local scheduler)"
git push origin main
echo "$(date '+%F %T') hash lists updated and pushed"
